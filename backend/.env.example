# Banco de dados
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/indoc

# Segurança — gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-em-producao-chave-muito-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos
UPLOAD_DIR=./uploads

# Fila assíncrona
REDIS_URL=redis://localhost:6379/0

# Admin inicial (criado só se não houver nenhum usuário)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@indoc.local
ADMIN_PASSWORD=
