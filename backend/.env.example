# Banco de dados
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/indoc

# Segurança — OBRIGATÓRIO trocar. Gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deixar o valor padrão emite aviso no startup e permite forjar tokens.
SECRET_KEY=
# O access token ficou curto porque agora existe refresh token (FASE 2).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cookies de sessão. Secure=true é o certo em produção, mas impede o navegador
# de guardar o cookie em http://localhost — deixe false no dev local.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.suaempresa.com.br

# Só ligue atrás de um proxy que reescreva X-Forwarded-For. Ligado sem proxy,
# qualquer cliente forja o IP e escapa do bloqueio de força bruta.
TRUST_PROXY_HEADERS=false

# Proteção contra força bruta no login (bloqueio dobra a cada reincidência)
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_BASE_SEGUNDOS=60
LOGIN_BLOQUEIO_MAX_SEGUNDOS=3600
LOGIN_JANELA_FALHAS_MINUTOS=15

# Firebase como provider de IDENTIDADE (não é banco de dados — o MySQL
# continua sendo o source of truth). Ver docs/auth.md.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Criar usuário do Indoc na hora para quem entrar pelo Firebase sem cadastro.
# Perigoso num ambiente corporativo: por padrão, só entra quem já existe.
FIREBASE_AUTO_PROVISIONAR=false

# CORS: origens permitidas (separadas por vírgula). Nunca use "*".
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos.
# Precisa ser o MESMO caminho na API e no worker Celery.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Fila assíncrona
REDIS_URL=redis://localhost:6379/0

# Admin inicial (criado só se não houver nenhum usuário e a senha estiver preenchida)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@indoc.local
ADMIN_PASSWORD=

# Schema: o dono do schema é o Alembic (`alembic upgrade head`).
# "true" cria as tabelas no startup e faz o banco divergir das migrations
# silenciosamente. Mantenha "false" — inclusive em dev.
AUTO_CREATE_TABLES=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (legível no terminal) | json (uma linha por evento, para agregadores)
LOG_FORMAT=text
