# Banco de dados
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/indoc

# Segurança — OBRIGATÓRIO trocar. Gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deixar o valor padrão emite aviso no startup e permite forjar tokens.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: origens permitidas (separadas por vírgula). Nunca use "*".
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos.
# Precisa ser o MESMO caminho na API e no worker Celery.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Fila assíncrona
REDIS_URL=redis://localhost:6379/0

# Admin inicial (criado só se não houver nenhum usuário e a senha estiver preenchida)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@indoc.local
ADMIN_PASSWORD=

# Schema: em produção deixe "false" e use `alembic upgrade head`.
# "true" cria as tabelas no startup (conveniente em dev).
AUTO_CREATE_TABLES=true

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
